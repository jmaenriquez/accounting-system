@inherits LayoutComponentBase
<PageTitle>MHC Portal</PageTitle>

<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

<style>
    :root {
        --zindex-overlay: 1351;
    }

    .mud-overlay {
        z-index: var(--zindex-overlay);
    }

    .mud-popover {
        z-index: calc(var(--zindex-overlay) + 3);
    }

    /* Ensure layout responsiveness */
    .app-title .mud-nav-link {
        padding: 8px 10px;
    }

        .app-title .mud-nav-link .mud-nav-link-text {
            padding: 0px;
            margin: 0px;
        }
</style>

<MudLayout>
    <MudAppBar Dense="true" Style="background-color:#00828F;">
        <MudContainer Class="d-flex justify-content-between align-items-center" Style="padding:0px;margin:0px;width:100%;max-width:100vw;">
            <MudContainer Class="d-flex align-items-center" Style="padding:0px;margin:0px;gap:5px;">
                <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@DrawerToggle" />
                <MudNavLink Style="height:fit-content;width:fit-content;padding:0px;" Class="app-title" Href="/">
                    <MudImage Src="favicon.png" />
                    MHC Portal
                </MudNavLink>
            </MudContainer>
        </MudContainer>
    </MudAppBar>

    <!-- Responsive Drawer -->
    <MudHidden Breakpoint="Breakpoint.SmAndDown">
        <MudDrawer @bind-Open="_drawerOpen" Variant="@DrawerVariant.Mini">
            <NavMenu IsOpen="_drawerOpen" />
        </MudDrawer>
    </MudHidden>

    <MudHidden Breakpoint="Breakpoint.MdAndUp">
        <MudDrawer @bind-Open="_drawerOpen" Variant="DrawerVariant.Temporary">
            <NavMenu IsOpen="_drawerOpen" />
        </MudDrawer>
    </MudHidden>

    <MudMainContent>
        <div style="overflow:hidden;margin-top:26px;margin-left:26px;">
            @Body
        </div>
    </MudMainContent>
</MudLayout>

@code {
    bool _drawerOpen = true; // Set to true to make the drawer open by default

    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
        StateHasChanged();
    }
}
