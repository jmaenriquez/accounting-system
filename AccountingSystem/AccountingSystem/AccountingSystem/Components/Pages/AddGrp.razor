@page "/addgrp"
@using AccountingSystem.Data
@using MudBlazor

@inject NavigationManager Navigate
@inject ISnackbar Snackbar
@inject IDialogService DialogService


<PageTitle>Add Groups</PageTitle>
<h3>Add New Group</h3>


<EditForm Model="@newGroup" OnValidSubmit="SubmitGrp">

    
    <MudGrid>
        <MudItem xs="12" sm="6" md="8" lg="10">
            <MudTextField Label="Name" @bind-Value="newGroup.name" />
        </MudItem>

        <MudItem xs="12" sm="6" md="8" lg="10">
            <MudTextField Label="Description" @bind-Value="newGroup.description" />
        </MudItem>

        <MudItem xs="12" sm="6" md="8" lg="10">
            <MudSelect T="AccountType" Label="Select an Account Type" @bind-Value="newGroup.type">
                <MudSelectItem Value="@AccountType.Debit"></MudSelectItem>
                <MudSelectItem Value="@AccountType.Credit"></MudSelectItem>
            </MudSelect>
        </MudItem>

        <MudItem xs="12" sm="6" md="8" lg="10">
            <MudSelect T="Status" Label="Select a Status" @bind-Value="newGroup.status">
                <MudSelectItem Value="@Status.Active">Active</MudSelectItem>
                <MudSelectItem Value="@Status.Inactive">Inactive</MudSelectItem>
            </MudSelect>
        </MudItem>
    </MudGrid>

    <MudGrid Gutter.Small Class="mt-5">
        <MudButton Onclick="SubmitGrp" Style="background-color: #00828F; color:#ffffff;">Add</MudButton>
        <MudButton Class="ml-2" OnClick="goBack" Color="Color.Error" Variant="Variant.Outlined">Cancel</MudButton>
    </MudGrid>

</EditForm>

@inject Data.AppDbContext Database
@code {

    public void goBack()
    {
        Navigate.NavigateTo("/accgrp");
    }

    public Group_List newGroup = new Group_List{

            datetime = DateOnly.FromDateTime(DateTime.Now),
            id = 0,
            name = "",
            description = "",
    };

    public bool added = false;

    private async Task SubmitGrp(){
        try
        {
            Database.Groups.Add(newGroup);
            await Database.SaveChangesAsync();
            added = true;
            await Task.Delay(500); // Simulate processing delay
            Snackbar.Add("Transaction successful!", Severity.Success);


            newGroup = new Group_List
        {
            datetime = DateOnly.FromDateTime(DateTime.Now), 
            id = 0,
            name = "",
            description = "",

        };

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
            Console.WriteLine(ex);
        }

    }
}
