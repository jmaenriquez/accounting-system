@page "/sheet"
@using AccountingSystem.Data
@using AccountingSystem.DTOs
@using AccountingSystem.Services
@inject JournalService jservice

<PageTitle>Balance Sheet</PageTitle>

<div class="rounded-3">
    <div class="top-container">
        <h4 class="m-3 w-100">Balance Sheet</h4>
    </div>

    <div class="container-fluid mt-3 mb-3">
        <MudPaper Class="p-4">
            <MudText Typo="Typo.h5" Align="Align.Center">Metaverse Holdings Corporation</MudText>

            <MudTable Items="@IncomeRows" Class="table-responsive">
                <HeaderContent>
                    <MudTh>Description</MudTh>
                    <MudTh Align="Right">Amount</MudTh>
                </HeaderContent>

                <RowTemplate>
                    @if (context.IsSectionHeader)
                    {
                        <MudTd ColSpan="2" >@context.AccountName</MudTd>
                    }
                    else if (context.IsSubtotal)
                    {
                        <MudTd Class="fw-bold">@context.AccountName</MudTd>
                        <MudTd Align="Right" Class="fw-bold">@($"{context.Amount:N2}")</MudTd>
                    }
                    else
                    {
                        <MudTd>@context.AccountName</MudTd>
                        <MudTd Align="Right">@($"{context.Amount:N2}")</MudTd>
                    }
                </RowTemplate>
            </MudTable>
        </MudPaper>
    </div>
</div>

@code {

    public class Balancesheet
    {
        public string? AccountName { get; set; }
        public decimal? Amount { get; set; }
        public bool IsSectionHeader { get; set; } = false;
        public bool IsSubtotal { get; set; } = false;
    }

    List<StatementDTO> State = new();
    List<Balancesheet> IncomeRows = new();

    protected override async Task OnInitializedAsync()
    {
        State = (await jservice.BalanceSheet()).ToList();

        var asset = State
            .Where(s => s.AccountGroup == "Asset")
            .Select(s => new Balancesheet { AccountName = s.AccountName, Amount = s.Debit - s.Credit});

        var liability = State
            .Where(s => s.AccountGroup == "Liability")
            .Select(s => new Balancesheet { AccountName = s.AccountName, Amount = s.Credit - s.Debit});

        var equity = State
            .Where(s => s.AccountGroup == "Equity")
            .Select(s => new Balancesheet { AccountName = s.AccountName, Amount = s.Credit - s.Debit });


        var revenue = State
            .Where(s => s.AccountGroup == "Revenue")
            .Select(s => new Balancesheet { AccountName = s.AccountName, Amount = s.Credit - s.Debit });

        var expenses = State
            .Where(s => s.AccountGroup == "Expense")
            .Select(s => new Balancesheet { AccountName = s.AccountName, Amount = s.Debit - s.Credit });

        var totalRevenue = revenue.Sum(r => r.Amount ?? 0);
        var totalExpenses = expenses.Sum(e => e.Amount ?? 0);
        var netIncome = totalRevenue - totalExpenses;

        var totalAsset = asset.Sum(a => a.Amount ?? 0);
        var totalLiab = liability.Sum(l => l.Amount ?? 0);
        var totalEquity = equity.Sum(e => e.Amount ?? 0);
        

        IncomeRows.Add(new Balancesheet { AccountName = "Asset", IsSectionHeader = true });
        IncomeRows.AddRange(asset);
        IncomeRows.Add(new Balancesheet { AccountName = "Total Asset", Amount = totalAsset, IsSubtotal = true });

        IncomeRows.Add(new Balancesheet { AccountName = "Liability and Equity", IsSectionHeader = true });
        IncomeRows.AddRange(liability);
        IncomeRows.AddRange(equity);
        
 
        IncomeRows.Add(new Balancesheet { AccountName = "Total Liabilities and Equity", Amount = totalLiab + totalEquity + netIncome, IsSubtotal = true });

    }
}


