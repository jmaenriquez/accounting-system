@page "/"

<div class="rounded-3">
    <div class="top-container">
        <h4 class="m-3 w-25">Dashboard</h4>
    </div>
</div>


<div class="mt-3 container-fluid justify-content-center">

    <div class="w-100">

        <MudCard class="w-50 text-center rounded-3 shadow-lg">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h5">Current Capital</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudText>Status:</MudText>
                <MudText Typo="Typo.h5">₱0.00</MudText>
            </MudCardContent>
        </MudCard>

        <MudCard class="w-50 text-center rounded-3 shadow-lg">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h5">Total Asset</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudText>Status:</MudText>
                <MudText Typo="Typo.h5">₱0.00</MudText>
            </MudCardContent>
        </MudCard>
    </div>

    <div>
        <MudCard class="w-50 text-center rounded-3 shadow-lg">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h5">Payables</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudText>Status:</MudText>
                <MudText Typo="Typo.h5">₱0.00</MudText>
            </MudCardContent>
            <MudCardActions>
                <MudButton Href="/ledger">Go to Payables</MudButton>
            </MudCardActions>
        </MudCard>

        <MudCard class="w-50 text-center rounded-3 shadow-lg">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h5">Receivables</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudText>Status:</MudText>
                <MudText Typo="Typo.h5">₱0.00</MudText>
            </MudCardContent>
            <MudCardActions>
                <MudButton Href="/ledger">Go to Receivables</MudButton>
            </MudCardActions>
        </MudCard>
    </div>

</div>

