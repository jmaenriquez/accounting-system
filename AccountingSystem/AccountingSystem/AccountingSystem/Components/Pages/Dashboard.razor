@page "/"
@using AccountingSystem.Data
@using AccountingSystem.Services
@using AccountingSystem.DTOs
@inject JournalService jservice
@inject NavigationManager Navigate
@inject ISnackbar Snackbar
@inject IDialogService DialogService


<div class="rounded-3 mb-3">
    <div class="top-container"> <h4 class="m-3 w-100%">Payables and Receivables</h4> </div>

    <div class="mt-3 mb-3 container-fluid justify-content-center">
        <div class="d-flex flex-wrap flex-md-nowrap">
            <MudCard class="w-100 w-md-50 rounded-3 shadow-sm me-md-3 mb-3" Style="min-width: 300px;">
                <MudCardHeader>
                    <CardHeaderContent>
                        <div class="d-flex align-items-center justify-content-between w-100">
                            <MudIcon Icon="@Icons.Material.Filled.CreditCard" Size="Size.Large" Style="background-color:#00828F; color:white; border-radius: 15%; padding: 8px;" />
                            <MudCardActions>
                                <MudButton Href="/ledger" Size="Size.Small" Color="Color.Primary">View Payables</MudButton>
                            </MudCardActions>
                        </div>
                        <MudText Typo="Typo.caption" Class="mt-1">Payables</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent class="text-end">
                    <MudText Typo="Typo.body1">Amount</MudText>
                    <MudText Typo="Typo.h4" Class="mt-2">₱@($"{PayablesAmount ?? 0:N2}")</MudText>
                </MudCardContent>
            </MudCard>

            <MudCard class="w-100 w-md-50 rounded-3 shadow-sm mb-3" Style="min-width: 300px;">
                <MudCardHeader>
                    <CardHeaderContent>
                        <div class="d-flex align-items-center justify-content-between w-100">
                            <MudIcon Icon="@Icons.Material.Filled.CreditCard" Size="Size.Large" Style="background-color:#00828F; color:white; border-radius: 15%; padding: 8px;" />
                            <MudCardActions>
                                <MudButton Href="/ledger" Size="Size.Small" Color="Color.Primary">View Receivables</MudButton>
                            </MudCardActions>
                        </div>
                        <MudText Typo="Typo.caption" Class="mt-1">Receivables</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent class="text-end">
                    <MudText Typo="Typo.body1">Amount</MudText>
                    <MudText Typo="Typo.h4" Class="mt-2">₱@($"{ReceivablesAmount ?? 0:N2}")</MudText>
                </MudCardContent>
            </MudCard>
        </div>
    </div>
</div>

<div class="rounded-3 mb-3">
    <div class="top-container"><h4 class="m-3 w-100%">Capital and Total Assets</h4></div>

    <div class="mt-3 mb-3 container-fluid justify-content-center">
        <div class="d-flex flex-wrap flex-md-nowrap">
            <MudCard class="w-100 w-md-50 rounded-3 shadow-sm me-md-3 mb-3" Style="min-width: 300px;">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h5" Class="mt-1">Current Capital</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent class="text-end">
                    <MudText Typo="Typo.body1">Amount</MudText>
                    <MudText Typo="Typo.h4" Class="mt-2">₱@($"{CapitalAmount ?? 0:N2}")</MudText>
                </MudCardContent>
            </MudCard>

            <MudCard class="w-100 w-md-50 rounded-3 shadow-sm mb-3" Style="min-width: 300px;">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h5" Class="mt-1">Total Asset</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent class="text-end">
                    <MudText Typo="Typo.body1">Amount</MudText>
                    <MudText Typo="Typo.h4" Class="mt-2">₱@($"{AssetAmount ?? 0:N2}")</MudText>
                </MudCardContent>
            </MudCard>
        </div>
    </div>
</div>



@code {
    public class dashboardList
    {

    }

    public decimal? PayablesAmount { get; set; }
    public decimal? ReceivablesAmount { get; set; }
    public decimal? AssetAmount { get; set; }
    public decimal? CapitalAmount { get; set; }

    List<StatementDTO> Data = new();
    List<dashboardList> totals = new();


    protected override async Task OnInitializedAsync()
    {
        await Payables();
        await Receivables();
        await CurrentCapital();
        await TotalAsset();
    }

    private async Task Payables()
    {
        Data = (await jservice.Dashboard()).ToList();

        PayablesAmount = Data
            .Where(d => d.AccountName == "Payables")
            .Sum(d => d.Credit - d.Debit);
    }

    private async Task Receivables()
    {
        Data = (await jservice.Dashboard()).ToList();

        ReceivablesAmount = Data
            .Where(d => d.AccountName == "Receivables")
            .Sum(d => d.Debit - d.Credit);
    }

    private async Task CurrentCapital()
    {
        Data = (await jservice.Dashboard()).ToList();

        var capital = Data
            .Where(c => c.AccountName == "Capital")
            .Sum(c => c.Credit - c.Debit);

        var expense = Data
            .Where(a => a.AccountGroup == "Expense")
            .Sum(a => a.Debit - a.Credit);        

        var withdraw = Data
            .Where(a => a.AccountGroup == "Withdrawal")
            .Sum(a => a.Debit - a.Credit);

        var revenue = Data
            .Where(a => a.AccountGroup == "Revenue")
            .Sum(a => a.Credit - a.Debit);


        var semiTotal = capital - expense - withdraw;

        CapitalAmount = semiTotal + revenue;
    }

    private async Task TotalAsset()
    {
        Data = (await jservice.Dashboard()).ToList();

        AssetAmount = Data
            .Where(d => d.AccountGroup == "Asset")
            .Sum(d => d.Debit - d.Credit);
    }


}