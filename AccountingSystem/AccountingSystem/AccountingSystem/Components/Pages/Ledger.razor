@page "/ledger"
@using AccountingSystem.Data
@using AccountingSystem.Services
@inject JournalService jservice
@using MudBlazor

<PageTitle>General Ledger</PageTitle>

<div class="rounded-3">

    <div class="top-container">

        <h4 class="m-3 w-100">General Ledger</h4>

        <div class="buttons" style="display: flex; align-items: center;">
            <MudHidden Breakpoint="Breakpoint.SmAndDown">
                <input class="searchbar" type="text" placeholder="Search..." @oninput="FilterEntries" />
            </MudHidden>
            <MudHidden Breakpoint="Breakpoint.MdAndUp">
                <div class="mobile-search">
                    <MudIcon Class="search-icon" Icon="@Icons.Material.Filled.Search" @onclick="ToggleSearch" />
                    <input class="search-input @(isSearchOpen ? "expanded" : "")" type="text" placeholder="  Search..." @oninput="FilterEntries" autofocus />
                </div>
            </MudHidden>
        </div>

    </div>

    <div>
        <div class="container-fluid mb-3">
            @foreach(var ledgerGroup in FilteredEntries.GroupBy(l => l.AccName!.name))
            {
                <MudTable Class="mt-3" Items="ledgerGroup">
                    <ToolBarContent>
                        <MudText Typo = "Typo.h5">@ledgerGroup.Key</MudText>
                    </ToolBarContent>
                    <HeaderContent>
                        <MudTh Class="fw-bold">Date</MudTh>
                        <MudTh Class="fw-bold">Account Name</MudTh>
                        <MudTh Class="fw-bold">Description</MudTh>
                        <MudTh Class="fw-bold">Sum of Debit</MudTh>
                        <MudTh Class="fw-bold">Sum of Credit</MudTh>
                        <MudTh Class="fw-bold">Sum of Balance</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Date">@context.datetime.ToString("MM-dd-yyyy")</MudTd>
                        <MudTd DataLabel="Account Name">@context.AccName!.name</MudTd>
                        <MudTd DataLabel="Description">@context.description</MudTd>
                        <MudTd DataLabel="Sum of Debit">@((context.debit ?? 0) > 0 ? $"{context.debit}" : "" )</MudTd>
                        <MudTd DataLabel="Sum of Credit">@((context.credit ?? 0) > 0 ? $"{context.credit}" : "")</MudTd>
                        <MudTd DataLabel="Sum of Balance">@((context.debit ?? 0) > 0 ? $"{context.debit}" : (context.credit ?? 0) > 0 ? $"{context.credit}" : "")</MudTd>
                    </RowTemplate>
                    <FooterContent>
                        <MudTd ColSpan="3" Align="Right" Class="fw-bold">Grand Total</MudTd>
                        <MudTd Align="Right" Class="fw-bold">@ledgerGroup.Sum(l => l.debit ?? 0).ToString("N2")</MudTd>
                        <MudTd Align="Right" Class="fw-bold">@ledgerGroup.Sum(l => l.credit ?? 0).ToString("N2")</MudTd>
                        <MudTd Align="Right" Class="fw-bold">@ledgerGroup.Sum(total => (total.debit ?? 0) - (total.credit ?? 0)).ToString("N2")</MudTd>
                    </FooterContent>
                </MudTable>
            }
        </div>
    </div>
</div>

@code {

    private bool isSearchOpen = false;
    [Parameter]
    public string accName { get; set; } = string.Empty;

    void initialize()
    {
        Snackbar.Add(accName);
    }

    protected override void OnInitialized()
    {
        initialize();
    }

    protected override void OnParametersSet()
    {
        initialize();
    }

    private void ToggleSearch()
    {
        isSearchOpen = !isSearchOpen;
    }

    List<Journal_Entry> Entries = new List<Journal_Entry>();
    List<Journal_Entry> FilteredEntries = new List<Journal_Entry>();
    protected override async Task OnInitializedAsync()
    {
        Entries = (await jservice.journalentries()).ToList();
        FilteredEntries = Entries;
    }

    private void FilterEntries(ChangeEventArgs e)
    {
        var searchTerm = e.Value?.ToString();
        if (string.IsNullOrEmpty(searchTerm))
        {
            FilteredEntries = Entries;
        }
        else
        {
            FilteredEntries = Entries.Where(entry => entry.AccName!.name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) || entry.description!.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) || entry.datetime.ToString("MM-dd-yyyy").Contains(searchTerm, StringComparison.OrdinalIgnoreCase) || entry.debit.ToString()!.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) || entry.credit.ToString()!.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)
            ).ToList();
        }
    }
}
