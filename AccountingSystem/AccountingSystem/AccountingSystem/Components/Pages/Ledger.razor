@page "/ledger"
@using AccountingSystem.Data
@using AccountingSystem.Services
@inject JournalService jservice

<PageTitle>General Ledger</PageTitle>

<div class="rounded-3">

	<div class="top-container">

        <h4 class="m-3 w-25">General Ledger</h4>

		<div class="buttons">
			<input class="searchbar" type="text" placeholder="Search..." @oninput="FilterEntries" />
		</div>

	</div>

	<div>
		<div class="container">
			@foreach(var ledgerGroup in Entries.GroupBy(l => l.AccName!.name))
                {
                    <h5 class="m-3">@ledgerGroup.Key</h5>
                    <table class="mt-3 table table-borderless table-sm fww-bold">
                        <thead class="table-info">
                            <tr>
                                <th>Date</th>
                                <th>Account Name</th>
                                <th>Description</th>
                                <th>Sum of Debit</th>
                                <th>Sum of Credit</th>
                                <th>Sum of Balance</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var data in ledgerGroup)
                            {
                                <tr>
                                    <td>@data.datetime.ToString("MM-dd-yyyy")</td>
                                    <td>@data.AccName!.name</td>
                                    <td>@data.description</td>
                                    <td>@(data.debit > 0 ? $"{data.debit}" : "" )</td>
                                    <td>@(data.credit > 0 ? $"{data.credit}" : "")</td>
                                    <td>@(data.debit > 0 ? $"{data.debit}" : data.credit > 0 ? $"{data.credit}" : "")</td>

                                </tr>
                            }
                        </tbody>

                        <tfoot>
                            <tr>
                                <td class="fw-bold">Grand Total</td>
                                <td></td>
                                <td></td>
                            <td class="fw-bold">@ledgerGroup.Sum(l => l.debit ?? 0).ToString("N2")</td>
                            <td class="fw-bold">@ledgerGroup.Sum(l => l.credit ?? 0).ToString("N2")</td>
                            <td class="fw-bold">@ledgerGroup.Sum(total => (total.debit ?? 0) - (total.credit ?? 0)).ToString("N2")</td>
                            </tr>
                        </tfoot>
                    </table>
				}
			

		</div>
	</div>
</div>


@code {
	List<Journal_Entry> Entries = new List<Journal_Entry>();
    List<Journal_Entry> FilteredEntries = new List<Journal_Entry>();
	protected override async Task OnInitializedAsync()
	{
		Entries = (await jservice.journalentries()).ToList();
        FilteredEntries = Entries;
	}

    private void FilterEntries(ChangeEventArgs e)
    {
        var searchTerm = e.Value?.ToString();
        if (string.IsNullOrEmpty(searchTerm))
        {
            FilteredEntries = Entries;
        }
        else
        {
            FilteredEntries = Entries.Where(entry => entry.AccName!.name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) || entry.description.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)).ToList();
        }
    }
}
