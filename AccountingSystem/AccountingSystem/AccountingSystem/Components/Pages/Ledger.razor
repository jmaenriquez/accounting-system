@page "/ledger"
@using AccountingSystem.Data
@using AccountingSystem.Services
@inject JournalService jservice

<PageTitle>General Ledger</PageTitle>

<div class="rounded-3">

	<div class="top-container">

		<h3 class="m-4">Genereal Ledger</h3>

		<div class="buttons">
			<input class="searchbar" type="text" placeholder="Search..." />
		</div>

	</div>

	<div>
		<div class="container">
			@foreach(var ledgerGroup in Entries.GroupBy(l => l.AccName!.name))
{
    <h5>@ledgerGroup.Key</h5>
    <table class="mt-3 table table-borderless table-sm">
        <thead class="table-info">
            <tr>
                <td>Date</td>
                <td>Account Name</td>
                <td>Description</td>
                <td>Sum of Debit</td>
                <td>Sum of Credit</td>
                <td>Sum of Balance</td>
            </tr>
        </thead>

        <tbody>
            @foreach (var data in ledgerGroup)
            {
                <tr>
                    <td>@data.datetime.ToString("MM-dd-yyyy")</td>
                    <td>@data.AccName!.name</td>
                    <td>@data.description</td>
                    <td>@(data.debit > 0 ? $"{data.debit}" : "" )</td>
                    <td>@(data.credit > 0 ? $"{data.credit}" : "")</td>
                    <td>@(data.debit > 0 ? $"{data.debit}" : data.credit > 0 ? $"{data.credit}" : "")</td>

                </tr>
            }
        </tbody>

        <tfoot>
            <tr>
                <td class="fw-bold">Grand Total</td>
                <td></td>
                <td></td>
                <td>@ledgerGroup.Sum(l => l.debit ?? 0).ToString("N2")</td>
                <td>@ledgerGroup.Sum(l => l.credit ?? 0).ToString("N2")</td>
                 <td>@ledgerGroup.Sum(total => (total.debit ?? 0) - (total.credit ?? 0)).ToString("N2")</td>
            </tr>
        </tfoot>
    </table>
				}
			}

		</div>
	</div>
</div>


@code {

	List<Journal_Entry> Entries = new List<Journal_Entry>();

	protected override async Task OnInitializedAsync()
	{
		Entries = (await jservice.journalentries()).ToList();
	}
}
