@page "/addacc"
@using AccountingSystem.Data
@using System.ComponentModel.DataAnnotations
@using MudBlazor

@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject Data.AppDbContext DbContext

<MudForm Model="@newAccount" OnValidSubmit="Submit" Class="m-4">

    <MudGrid>
        <MudItem xs="12" sm="6" md="8" lg="10">
            <MudTextField Label="Name" @bind-Value="newAccount.name" />
        </MudItem>

        <MudItem xs="12" sm="6" md="8" lg="10">
            <MudTextField Label="Description" @bind-Value="newAccount.description" />
        </MudItem>

        <MudItem xs="12" sm="6" md="8" lg="10">
            <MudSelect T="Status" Label="Status" @bind-Value="newAccount.status">
                <MudSelectItem Value="@Status.Active"></MudSelectItem>
                <MudSelectItem Value="@Status.Inactive"></MudSelectItem>
            </MudSelect>
        </MudItem>
    </MudGrid>

    <div class="w-100 d-flex justify-content-end">
        <MudGrid Class="w-100 mt-5 d-flex justify-content-end">
            <MudButton OnClick="Submit" Style="background-color: #00828F; color:#ffffff;">Add</MudButton>
            <MudButton Class="ml-2" OnClick="goBack" Color="Color.Error" Variant="Variant.Outlined">Cancel</MudButton>
        </MudGrid>
    </div>


</MudForm>


@code {

    [Parameter]
    public Account_List accData { get; set; } = new Account_List
        {
            date = DateOnly.FromDateTime(DateTime.Now),
            id = 0,
            name = "",
            description = "",
        };


    public void goBack()
    {
        Nav.NavigateTo("/acclist");
    }
    public Account_List newAccount = new Account_List
    {
        date = DateOnly.FromDateTime(DateTime.Now),
        id = 0,
        name = "",
        description = "",
    };

    public bool submitted = false;

    private async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(newAccount.name) || string.IsNullOrWhiteSpace(newAccount.name))
        {
            Snackbar.Add("Please fill empty fields.", Severity.Warning);
        }

        else
        {
            DbContext.Accounts.Add(newAccount);
            await DbContext.SaveChangesAsync();
            submitted = true;
            await Task.Delay(500); // Simulate processing delay
            Snackbar.Add("Transaction successful!", Severity.Success);

            newAccount = new Account_List
            {
                date = DateOnly.FromDateTime(DateTime.Now),
                name = "",
                description = "",
            };

            StateHasChanged();
        }
        
    }

}