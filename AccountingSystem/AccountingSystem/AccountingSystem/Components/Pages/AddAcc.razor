@page "/addacc"

@inject NavigationManager Nav

@using AccountingSystem.Data
@using System.ComponentModel.DataAnnotations
@using MudBlazor

<h3>Add New Account</h3>

<EditForm Model="@newAccount" OnValidSubmit="Submit">


    <MudGrid Gutter.Small>
        <MudItem xs="12" sm="6" md="8" lg = "10">
            <MudTextField Label="Name" @bind-Value="newAccount.name" />
        </MudItem>

        <MudItem xs="12" sm="6" md="8" lg = "10">
            <MudTextField Label="Description" @bind-Value="newAccount.description" />
        </MudItem>

        <MudItem xs="12" sm="6" md="8" lg = "10">
            <MudSelect T="string" Label="Status" @bind-Value="newAccount.status">
                <MudSelectItem Value="@("Active")">Active</MudSelectItem>
                <MudSelectItem Value="@("Inactive")">Inactive</MudSelectItem>
            </MudSelect>
        </MudItem>
    </MudGrid>


    <MudGrid Gutter.mall Class="mt-5">
        <MudButton OnClick="Submit" Style="background-color: #00828F; color:#ffffff;">Add</MudButton>
        <MudButton Class="ml-2" OnClick="goBack" Color = "Color.Error" Variant="Variant.Outlined" >Cancel</MudButton>
    </MudGrid>

</EditForm>

@inject ISnackbar Snackbar
@inject IDialogService DialogService

@inject Data.AppDbContext DbContext
@code {

    public void goBack()
    {
        Nav.NavigateTo("/acclist");
    }
    public Account_List newAccount = new Account_List
    {
        date = DateOnly.FromDateTime(DateTime.Now),
        id = 0,
        name = "",
        description = "",
        status = ""
    };

    public bool submitted = false;

    private async Task Submit()
    {
        try
        {
            DbContext.Accounts.Add(newAccount);
            await DbContext.SaveChangesAsync();
            submitted = true;
            await Task.Delay(500); // Simulate processing delay
            Snackbar.Add("Transaction successful!", Severity.Success);

            newAccount = new Account_List
            {
                date = DateOnly.FromDateTime(DateTime.Now),
                id = 0,
                name = "",
                description = "",
                status = ""
            };

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

}