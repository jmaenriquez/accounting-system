@page "/addacc"

@using AccountingSystem.Data
@using System.ComponentModel.DataAnnotations

<h3>Add New Account</h3>

<EditForm Model="@newAccount" OnValidSubmit="Submit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="m-3">
        <label>Name</label>
        <InputText class="form-control" @bind-Value="newAccount.name" />
        <ValidationMessage For="@(() => newAccount.name)" />
    </div>

    <div class="m-3">
        <label>Description</label>
        <InputText class="form-control" @bind-Value="newAccount.description" />
        <ValidationMessage For="@(() => newAccount.description)" />
    </div>

    <div class="m-3">
        <label>Status</label>
        <select class="form-control" @bind="newAccount.status">
            <option value="Active">Active</option>
            <option value="Inactive">Inactive</option>
        </select>
        <ValidationMessage For="@(() => newAccount.status)" />
    </div>

    <button class="m-3 btn btn-primary" type="submit">Submit</button>

    @if (submitted)
    {
        <p>Account has been added successfully</p>
    }
</EditForm>

@inject Data.AppDbContext DbContext
@code {
    public Account_List newAccount = new Account_List
    {
        date = DateOnly.FromDateTime(DateTime.Now),
        accountId = 0,
        name = "",
        description = "",
        status = ""
    };

    public bool submitted = false;

    private async Task Submit()
    {
        try
        {
            DbContext.Accounts.Add(newAccount);
            await DbContext.SaveChangesAsync();
            submitted = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }
}