@page "/balance"
@using AccountingSystem.Data
@using AccountingSystem.Services
@inject JournalService jservice

<PageTitle>Trial Balance</PageTitle>

<div class="rounded-3">

	<div class="top-container">

		<h4 class="m-3 w-25">Trial Balance</h4>

		<div class="buttons">
			<input class="searchbar" type="text" placeholder="Search..." @oninput="FilterEntries" />
		</div>

	</div>

	@if(Entries.Count > 0)
	{
		<div>
			<div>
				<table class= "mt-3 table table-borderless table-sm">
					<thead class="table-info">
						<tr>
							<th>Accounts</th>
							<th>Sum of Debit</th>
							<th>Sum of Credit</th>
							<th>Sum of Balance</th>
						</tr>
					</thead>

					@foreach (var balance in Entries)
					{
						<tbody>
							<tr>
								<td>@balance.AccountName</td>
								<td>@(balance.Debit > 0 ? $"{balance.Debit}" : "") </td>
								<td>@(balance.Credit > 0 ? $"{balance.Credit}" : "")</td>
								<td>@(balance.Debit - balance.Credit)</td>
							</tr>
						</tbody>
					}

                            <tfoot class="table-light">
                                <tr>
                                    <td class="fw-bold">Grand Total</td>
							<td class="fw-bold">@Entries.Sum(t => t.Debit).ToString("N2")</td>
							<td class="fw-bold">@Entries.Sum(t => t.Credit).ToString("N2")</td>
                                    <td></td>
                                </tr>
                            </tfoot>
				</table>
			</div>
		</div>
	}
</div>


@code {
	List<LedgerDto> Entries = new List<LedgerDto>();
	List<Journal_Entry> Journal = new List<Journal_Entry>();
	List<Journal_Entry> FilteredEntries = new List<Journal_Entry>();

	protected override async Task OnInitializedAsync()
	{
		Entries = (await jservice.GetLedger()).ToList();

		StateHasChanged();
		FilteredEntries = Journal;

	}

	private void FilterEntries(ChangeEventArgs e)
	{
		var searchTerm = e.Value?.ToString();
		if (string.IsNullOrEmpty(searchTerm))
		{
			FilteredEntries = Journal;
		}
		else
		{
			FilteredEntries = Journal.Where(entry => entry.AccName!.name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) || entry.description.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)).ToList();
		}
	}
}
