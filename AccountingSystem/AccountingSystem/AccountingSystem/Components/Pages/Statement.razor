@page "/statement"
@using AccountingSystem.Data
@using AccountingSystem.DTOs
@using AccountingSystem.Services
@inject JournalService jservice

<PageTitle>Income Statement</PageTitle>

<div class="rounded-3">
    <div class="top-container">
        <h4 class="m-3 w-100">Income Statement</h4>
    </div>

    <div class="container-fluid mt-3">
        <MudPaper Class="p-4">
            <MudText Typo="Typo.h5" Align="Align.Center">Metaverse Holdings Corporation</MudText>

            <MudTable Items="@IncomeRows">
                <HeaderContent>
                    <MudTh>Description</MudTh>
                    <MudTh Align="Right">Amount</MudTh>
                </HeaderContent>

                <RowTemplate Context="context">
                    @if (context.IsSectionHeader)
                    {
                        <MudTd ColSpan="2" Class="fw-bold" DataLabel="Account Name">@context.AccountName</MudTd>
                    }
                    else if (context.IsSubtotal)
                    {
                        <MudTd Class="fw-bold" DataLabel="Account Name">@context.AccountName</MudTd>
                        <MudTd Align="Right" Class="fw-bold" DataLabel="Amount">@($"{context.Amount:N2}")</MudTd>
                    }
                    else
                    {
                        <MudTd DataLabel="Account Name">@context.AccountName</MudTd>
                        <MudTd Align="Right" DataLabel="Amount">@($"{context.Amount:N2}")</MudTd>
                    }
                </RowTemplate>
            </MudTable>
        </MudPaper>
    </div>
</div>


@code {
    public class IncomeRow
    {
        public string? AccountName { get; set; }
        public decimal? Amount { get; set; }
        public bool IsSectionHeader { get; set; } = false;
        public bool IsSubtotal { get; set; } = false;
    }

    List<StatementDTO> State = new();
    List<IncomeRow> IncomeRows = new();

    protected override async Task OnInitializedAsync()
    {
        State = (await jservice.GetStatement()).ToList();

        var revenue = State
            .Where(s => s.AccountGroup == "Revenue")
            .Select(s => new IncomeRow { AccountName = s.AccountName, Amount = s.Credit });

        var expenses = State
            .Where(s => s.AccountGroup == "Expense")
            .Select(s => new IncomeRow { AccountName = s.AccountName, Amount = s.Debit });

        var totalRevenue = revenue.Sum(r => r.Amount ?? 0);
        var totalExpenses = expenses.Sum(e => e.Amount ?? 0);
        var netIncome = totalRevenue - totalExpenses;

        IncomeRows.Add(new IncomeRow { AccountName = "Revenue", IsSectionHeader = true });
        IncomeRows.AddRange(revenue);
        IncomeRows.Add(new IncomeRow { AccountName = "Total Revenue", Amount = totalRevenue, IsSubtotal = true });

        IncomeRows.Add(new IncomeRow { AccountName = "Expenses", IsSectionHeader = true });
        IncomeRows.AddRange(expenses);
        IncomeRows.Add(new IncomeRow { AccountName = "Total Expenses", Amount = totalExpenses, IsSubtotal = true });

        IncomeRows.Add(new IncomeRow { AccountName = "Net Income", Amount = netIncome, IsSubtotal = true });
    }
}
