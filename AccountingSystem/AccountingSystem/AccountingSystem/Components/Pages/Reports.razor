@page "/reports"
@using System.Drawing

@layout MainLayout

<PageTitle>Reports</PageTitle>

<div class="rounded-3">
    <div class="top-container">
        <h4 class="m-3 w-100">Reports</h4>

        <div class="buttons" style="display: flex; align-items: center;">

            <MudButton Variant="Variant.Filled" OnClick="printReports" Style="width:fit-content; background-color:#00828F; color:white; margin-left: 10px;">
                <MudHidden Breakpoint="Breakpoint.SmAndDown">
                    <MudIcon Icon="@Icons.Material.Filled.Print" />   Generate Report
                </MudHidden>
                <MudHidden Breakpoint="Breakpoint.MdAndUp">
                    <MudIcon Icon="@Icons.Material.Filled.Print" />
                </MudHidden>
            </MudButton>

        </div>
    </div>

    <div class="container-fluid mt-3 mb-3">
        <div class="w-100 d-inline-flex">


            <div class="w-25">

                @if (selectReport == 0)
                {
                    <p>Select a report from dropdown</p>
                }
            </div>

            <div class="w-50">
                <MudItem xs="12" sm="12" md="4">
                    <MudSelect Variant="Variant.Filled" T="int" @bind-Value="selectReport" Style="width: 100px;">
                        <MudSelectItem Value="1">Journal Entry</MudSelectItem>
                        <MudSelectItem Value="2">General Ledger</MudSelectItem>
                        <MudSelectItem Value="3">Trial Balance</MudSelectItem>
                        <MudSelectItem Value="4">Income Statement</MudSelectItem>
                        <MudSelectItem Value="5">Balance Sheet</MudSelectItem>
                    </MudSelect>
                </MudItem>
            </div>

            <div class="d-inline-flex">
                @*Set Filter *@

                <MudDatePicker Label="Start"></MudDatePicker>
                <div>
                    <p>To</p>
                </div>
                <MudDatePicker Label="End"></MudDatePicker>
            </div>
        </div>
    </div>
</div>





@code {
    private Journal journalRef;

    private int selectReport;

    List<Journal_Entry> Entries = new List<Journal_Entry>();

    public void MergeAndCenter(ExcelRange range)
    {
        range.Merge = true;
        range.Style.VerticalAlignment = ExcelVerticalAlignment.Center;
    }

    public void SetAllBorders(ExcelRange range, ExcelBorderStyle excelBorderStyle, System.Drawing.Color color)
    {
        range.Style.Border.Top.Style = excelBorderStyle;
        range.Style.Border.Left.Style = excelBorderStyle;
        range.Style.Border.Right.Style = excelBorderStyle;
        range.Style.Border.Bottom.Style = excelBorderStyle;

        range.Style.Border.Top.Color.SetColor(color);
        range.Style.Border.Left.Color.SetColor(color);
        range.Style.Border.Right.Color.SetColor(color);
        range.Style.Border.Bottom.Color.SetColor(color);
    }

    public void SetTopBorder(ExcelRange range, ExcelBorderStyle excelBorderStyle, System.Drawing.Color color)
    {
        range.Style.Border.Top.Style = excelBorderStyle;
        range.Style.Border.Top.Color.SetColor(color);
    }



    private async Task printReports()
    {
         
        

        ExcelPackage.License.SetNonCommercialOrganization("MHC");
        using var print = new ExcelPackage();


        var worksheet = print.Workbook.Worksheets.Add("Sheet1");

        worksheet.Cells.Style.Font.Name = "Aptos";

        worksheet.Cells.AutoFitColumns();
        worksheet.Cells.Style.HorizontalAlignment = ExcelHorizontalAlignment.Center;
        worksheet.Cells.Style.Fill.PatternType = ExcelFillStyle.Solid;
        worksheet.Cells.Style.Fill.BackgroundColor.SetColor(System.Drawing.Color.White);

        worksheet.SetValue("A1", "DAILY TIME RECORD");       
        MergeAndCenter(worksheet.Cells["A1:D2"]);
        worksheet.Cells["A1:D2"].Style.Font.Bold = true;
        SetTopBorder(worksheet.Cells["A1:D2"], ExcelBorderStyle.Thin, System.Drawing.Color.Black);

        worksheet.Cells["A4"].Value = "Hello Infinity";
        worksheet.Cells["A5"].Value = "Hello Infinity";
        worksheet.Cells["A6"].Value = "Hello Infinity";
        

        var stream = new MemoryStream();
        print.SaveAs(stream);
        stream.Position = 0;

        var bytes = stream.ToArray();
        var base64 = Convert.ToBase64String(bytes);
        var fileName = "Accounting Reports.xlsx";

        await JS.InvokeVoidAsync("downloadFile", fileName, base64);
    }

    [Inject] 
    IJSRuntime JS { get; set; }
}
