@page "/accgrp"
@using AccountingSystem.Data
@using AccountingSystem.Services
@inject GroupService grpService
@inject NavigationManager Navigate
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Account Groups</PageTitle>

<div class="rounded-3">
    <div class="top-container">
        <h4 class="m-4 w-25">Account Groups</h4>

        <div class="buttons" style="display: flex; align-items: center;">
            <MudHidden Breakpoint="Breakpoint.MdAndUp">
                <div class="mobile-search">
                    <MudButton Variant="Variant.Filled" OnClick="ToggleSearch" Style="width:fit-content; background-color:#00828F; color:white; margin-left: 10px;">
                        <MudIcon Class="search-icon" Icon="@Icons.Material.Filled.Search" />
                    </MudButton>
                    <input class="search-input @(isSearchOpen ? "expanded" : "")" type="text" placeholder="Search..." @oninput="FilterEntries" autofocus />
                </div>
            </MudHidden>

            <MudHidden Breakpoint="Breakpoint.MdAndUp">
                <div class="mobile-search">
                    <MudButton Variant="Variant.Filled" OnClick="ToggleSearch" Style="width:fit-content; background-color:#00828F; color:white; margin-left: 10px;">
                        <MudIcon Class="search-icon" Icon="@Icons.Material.Filled.Search" />
                    </MudButton>
                    <input class="search-input @(isSearchOpen ? "expanded" : "")" type="text" placeholder="Search..." @oninput="FilterEntries" autofocus />
                </div>
            </MudHidden>

            <MudButton Variant="Variant.Filled" OnClick="OpenAddGrpDialog" Style="width:fit-content; background-color:#00828F; color:white; margin-left: 10px;">
                <MudHidden Breakpoint="Breakpoint.SmAndDown">
                    <MudIcon Icon="@Icons.Material.Filled.Add" /> New Entry
                </MudHidden>
                <MudHidden Breakpoint="Breakpoint.MdAndUp">
                    <MudIcon Icon="@Icons.Material.Filled.Add" />
                </MudHidden>
            </MudButton>
        </div>
    </div>

    <div class="container-fluid mb-3">
        <MudTable Class="mt-4" Items="@FilteredEntries" Dense="true" Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh Class="fw-bold">Account Id</MudTh>
                <MudTh Class="fw-bold">Account Name</MudTh>
                <MudTh Class="fw-bold">Description</MudTh>
                <MudTh Class="fw-bold">Account Type</MudTh>
                <MudTh Class="fw-bold">Status</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd data-label="Account Id">@context.id</MudTd>
                <MudTd data-label="Account Name">@context.name</MudTd>
                <MudTd data-label="Description">@context.description</MudTd>
                <MudTd data-label="Type">@context.type</MudTd>
                <MudTd data-label="Status">@context.status</MudTd>
                <MudTd>
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert">
                        <MudMenuItem Icon="@Icons.Material.Filled.Edit" Label="Edit" OnClick="() => Edit(context)" />
                        <MudMenuItem Icon="@Icons.Material.Filled.Delete" Label="Delete" OnClick="() => Delete(context.id)" />
                    </MudMenu>
                </MudTd>
            </RowTemplate>

        </MudTable>
    </div>
</div>



@code {

    private bool isSearchOpen = false;

    private void ToggleSearch()
    {
        isSearchOpen = !isSearchOpen;
    }

    List<Group_List> GroupList = new List<Group_List>();
    List<Group_List> FilteredEntries = new List<Group_List>();

    protected override async Task OnInitializedAsync()
    {
        GroupList = (await grpService.GroupItems())
        .Where(g => !g.isDeleted)
        .ToList();
        FilteredEntries = GroupList;
    }

    private async Task Delete(int grpId)
    {
        var group = GroupList.Where(g => g.id == grpId).ToList();

        foreach (var grp in group)
        {
            grp.isDeleted = true;
        }

        await grpService.UpdateGrpList(group);
        GroupList = GroupList.Where(g => !g.isDeleted).ToList();
        StateHasChanged();
        FilteredEntries = GroupList;
        Snackbar.Add("A Group has been marked as Deleted", Severity.Success);
    }

    //Edit
    private async Task Edit(Group_List editgrp)
    {
        var parameters = new DialogParameters
        {
            {"grpData", editgrp}
        };
        var options = new DialogOptions { 
            CloseButton = true, 
            MaxWidth = MaxWidth.Small, 
            FullWidth = true,
            Position = DialogPosition.Center,
            BackdropClick = true
        };
        var dialog = await DialogService.ShowAsync<AddGrp>("Edit Group", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await HandleSubmit();
        }
    }

    private async Task OpenAddGrpDialog()
    {
        var parameters = new DialogParameters();
        var options = new DialogOptions { 
            CloseButton = true, 
            MaxWidth = MaxWidth.Small, 
            FullWidth = true,
            Position = DialogPosition.Center,
            BackdropClick = true
        };
        var dialog = await DialogService.ShowAsync<AddGrp>("Add New Group", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await HandleSubmit();
        }
    }


    private async Task HandleSubmit()
    {
        GroupList = (await grpService.GroupItems())
            .Where(g => !g.isDeleted)
            .ToList();
        FilteredEntries = GroupList;
        StateHasChanged();
    }

    private void FilterEntries(ChangeEventArgs e)
    {
        var searchTerm = e.Value?.ToString();
        if (string.IsNullOrEmpty(searchTerm))
        {
            FilteredEntries = GroupList;
        }
        else
        {
            FilteredEntries = GroupList.Where(entry => entry.name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) || entry.description.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) || entry.datetime.ToString("MM-dd-yyyy").Contains(searchTerm, StringComparison.OrdinalIgnoreCase) || entry.type.ToString().Contains(searchTerm,StringComparison.OrdinalIgnoreCase)
            ).ToList();
        }
    }
}
