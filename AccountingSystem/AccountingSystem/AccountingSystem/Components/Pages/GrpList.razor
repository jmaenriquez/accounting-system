@page "/accgrp"

@inject NavigationManager Navigate

<PageTitle>Account Groups</PageTitle>

<div class="rounded-3">

    <div class="top-container">

        <h3 class="m-4">Account Groups</h3>

        <div class="buttons">
            <input class="searchbar" type="text" placeholder="Search..." />
            <button class="btn add" @onclick="navigateToAddGrp">Add New</button>
        </div>
    </div>

    <table class="mt-3 table table-borderless table-sm">
        <thead class="table-info ">
            <tr>
                <th>Date</th>
                <th>Account Id</th>
                <th>Account Name</th>
                <th>Description</th>
                <th>Account Type</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>

            @foreach (var grp in GroupList)
            {
                <tr>
                    <td>@grp.datetime</td>
                    <td>@grp.id</td>
                    <td>@grp.name</td>
                    <td>@grp.description</td>
                    <td>@grp.type</td>
                    <td>@grp.status</td>
                    <td>Actions</td>
                </tr>
            }
            
        </tbody>
    </table>
</div>


@using AccountingSystem.Data
@using AccountingSystem.Services
@inject GroupService grpService

@code {



    private void navigateToAddGrp()
    {
        Navigate.NavigateTo("/addgrp");
    }

    List<Group_List> GroupList = new List<Group_List>();

     protected override async Task OnInitializedAsync()
    {
        await LoadAccounts();
        await Refresh();

    }

    private async Task LoadAccounts()
    {
        GroupList = (await grpService.GroupItems()).ToList();
        StateHasChanged();
    }

    private async Task Refresh()
    {
        while (true)
        {
            await LoadAccounts();
        }
    }
}
