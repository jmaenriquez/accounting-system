@page "/accgrp"
@using AccountingSystem.Data
@using AccountingSystem.Services
@inject GroupService grpService
@inject NavigationManager Navigate
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Account Groups</PageTitle>

<div class="rounded-3">

    <div class="top-container">

        <h4 class="m-4 w-25">Account Groups</h4>

        <div class="buttons">
            <input class="searchbar" type="text" placeholder="Search..." />
            <button class="btn add" @onclick="OpenAddGrpDialog">Add New Group</button>
        </div>
    </div>

    <div class="container-fluid">
        <MudTable Class="mt-4" Items="@GroupList" Dense="true"
        Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh Class="fw-bold">Account Id</MudTh>
                <MudTh Class="fw-bold">Account Name</MudTh>
                <MudTh Class="fw-bold">Description</MudTh>
                <MudTh Class="fw-bold">Account Type</MudTh>
                <MudTh Class="fw-bold">Status</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.id</MudTd>
                <MudTd>@context.name</MudTd>
                <MudTd>@context.description</MudTd>
                <MudTd>@context.type</MudTd>
                <MudTd>@context.status</MudTd>
                <MudTd>
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert">
                        <MudMenuItem Icon="@Icons.Material.Filled.Edit" Label="Edit" OnClick="() => Edit(context)" />
                        <MudMenuItem Icon="@Icons.Material.Filled.Delete" Label="Delete" OnClick="() => Delete(context.id)" />
                    </MudMenu>
                </MudTd>
            </RowTemplate>
        </MudTable>
    </div>

</div>

@code {

    private void navigateToAddGrp()
    {
        Navigate.NavigateTo("/addgrp");
    }

    List<Group_List> GroupList = new List<Group_List>();

    protected override async Task OnInitializedAsync()
    {
        GroupList = (await grpService.GroupItems()).ToList();
        StateHasChanged();
    }

    private async Task Delete(int grpId)
    {
        var group = GroupList.Where(g => g.id == grpId).ToList();

        foreach (var grp in group)
        {
            grp.isDeleted = true;
        }

        await grpService.UpdateGrpList(group);
        GroupList = GroupList.Where(g => !g.isDeleted).ToList();
        StateHasChanged();

        Snackbar.Add("A Group has been marked as Deleted", Severity.Success);
    }

    //Edit
    private async Task Edit(Group_List editgrp)
    {
        var parameters = new DialogParameters
        {
            {"grpData", editgrp}
        };
        var options = new DialogOptions { 
            CloseButton = true, 
            MaxWidth = MaxWidth.Small, 
            FullWidth = true,
            Position = DialogPosition.Center,
            BackdropClick = true
        };
        var dialog = await DialogService.ShowAsync<AddGrp>("Edit Group", parameters, options);

        var result = await dialog.Result;
    }

    private async Task OpenAddGrpDialog()
    {
        var parameters = new DialogParameters();
        var options = new DialogOptions { 
            CloseButton = true, 
            MaxWidth = MaxWidth.Small, 
            FullWidth = true,
            Position = DialogPosition.Center,
            BackdropClick = true
        };
        var dialog = await DialogService.ShowAsync<AddGrp>("Add New Group", parameters, options);
        var result = await dialog.Result;
    }
}
