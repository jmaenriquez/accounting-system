@page "/addrecords"
@using AccountingSystem.Data
@using AccountingSystem.Services
@inject NavigationManager Navigate
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject Data.AppDbContext DbContext
@inject GroupService grpService
@inject AccountService accountService;

<h3>Add Records</h3>


<EditForm Model = "@newEntry" OnValidSubmit="Save">

    <MudGrid>
        <MudItem Gutter.Small xs="12" sm="6" md="8" lg="10">

            <MudItem>
                <MudDatePicker Label="Date" @bind-Value="newEntry.datetime" 
                DateFormat="MM-dd-yyyy"
                Onclosed="UpdateDateOnly"/>
            </MudItem>

            <MudItem>
                <MudTextField Label="Description" @bind-Value="newEntry.description" />
            </MudItem>

            <MudItem>
                <MudSelect T="Account_List" Label="Account Name" @bind-Value="newEntry.AccName">
                    @foreach (var accs in AccountNames)
                    {
                        <MudSelectItem T="Account_List" Value="@accs">@accs.name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem>
                <MudSelect T="Group_List" Label="Account Group" @bind-Value="newEntry.AccGrp">
                    @foreach (var gnames in GroupList)
                    {
                        <MudSelectItem T="Group_List" Value="@gnames">@gnames.name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem>
                <MudTextField Label="Amount" Type="number" @bind-Value="tempAcc" />
            </MudItem>

        </MudItem>

    </MudGrid>

    <MudButton Class="mt-3" OnClick="Save" Style="background-color: #F9F9F9;">Save</MudButton>


</EditForm>


<table class="mt-3 table table-responsive table-responsive-lg">
    <thead class="">
        <tr>
            <th>   </th>
            <th>Account</th>
            <th>Group</th>
            <th>Debit</th>
            <th>Credit</th>
        </tr>
    </thead>
    <tbody class="table-light">

        @foreach(var trial in Entries) 
        {
            <tr>
                <td>
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" OnClick="() => RemoveTrial(trial)" />
                </td>
                <td>@trial.AccName?.name</td>
                <td>@trial.AccGrp?.name</td>
                <td>@(trial.debit.HasValue ? trial.debit.Value.ToString("N2") : "")</td>
                <td>@(trial.credit.HasValue ? trial.credit.Value.ToString("N2") : "")</td>
            </tr>
        }

    </tbody>

    <tfoot>
        <tr>
            <td></td>
            <td></td>
            <td>Total</td>
            <td>@Overall.ToString("N2")</td>
        </tr>
    </tfoot>
</table>

<div>
    <div class="justify-content-lg-end d-flex m-5">
        <MudGrid Gutter.Small>
            <MudButton Onclick="Submit" Style="background-color: #00828F; color:#ffffff;">Add</MudButton>
            <MudButton Class="ml-2" OnClick="goBack" Color="Color.Error" Variant="Variant.Outlined">Cancel</MudButton>
        </MudGrid>
    </div>
</div>




@code {

    //Global Functions for the Journal Entry and Trial Balance

    List<Group_List> GroupList = new List<Group_List>();
    List<Account_List> AccountNames = new List<Account_List>();


    private decimal TotalDebit => Entries.Where(a => a.AccGrp?.type == AccountType.Debit).Sum(a => a.debit ?? 0);
    private decimal TotalCredit => Entries.Where(a => a.AccGrp?.type == AccountType.Credit).Sum(a => a.credit ?? 0);

    public decimal Overall => TotalDebit - TotalCredit;
    private decimal? tempAcc;

    //End of Global Functions





    //This section is for the back button

    private void goBack()
    {
        Navigate.NavigateTo("/journal");
    }

    //End of back button section


    private void RemoveTrial(Journal_Entry trial)
    {
        Entries.Remove(trial);
        StateHasChanged();
    }



    //This section is for saving the Trial Balance
    List<Journal_Entry> Entries = new List<Journal_Entry>();
    public Journal_Entry newEntry = new Journal_Entry();

    private async Task Save()
    {
        if (newEntry.AccGrp == null || newEntry.AccName == null || newEntry.description == null)
        {
            Snackbar.Add("Please Fill the Empty Fields", Severity.Warning);
            return;
        }

        newEntry.debit = newEntry.Type == AccountType.Debit ? tempAcc ?? 0 : 0;
        newEntry.credit = newEntry.Type == AccountType.Credit ? tempAcc ?? 0 : 0;

        Entries.Add(new Journal_Entry
            {
                datetime = newEntry.datetime,
                description = newEntry.description,
                AccName = newEntry.AccName,
                AccGrp = newEntry.AccGrp,
                debit = newEntry.debit,
                credit = newEntry.credit,
            });

        newEntry = new Journal_Entry();

        tempAcc = null;
        StateHasChanged();

        await Task.CompletedTask;
    }

    //End of Saving Section



    //This section is for submitting the Journal Entry

    private async Task Submit()
    {
        
        var TransactId = Guid.NewGuid();
        
        if (Overall == 0){
            
            foreach (var entry in Entries)
            {
                var journal = new Journal_Entry
                {
                    TransactId = TransactId,
                    datetime = entry.datetime,
                    description = entry.description,
                    AccGrpId = entry.AccGrp!.id,
                    AccNameId = entry.AccName!.id,
                    debit = entry.debit,
                    credit = entry.credit
                };
                Console.WriteLine(journal.AccNameId);
                DbContext.Journal.Add(journal);
            }
            
            await DbContext.SaveChangesAsync();
            Snackbar.Add("New Entry Added", Severity.Success);
            Navigate.NavigateTo("/journal");

            Entries.Clear();
            tempAcc = null;

            StateHasChanged();

        }
        else{
            Snackbar.Add("Trial Balance must be Balanced!", Severity.Error);
            return;
        }

    }
    //End of Journal Entry Section


    //This section is for the Fetching of Data


    protected override async Task OnInitializedAsync()
    {

        try
        {
            var filterName = await grpService.GroupItems();
            GroupList = filterName.ToList();

            var filterAcc = await accountService.GetAllAccounts();
            AccountNames = filterAcc.ToList();

            Entries = new List<Journal_Entry>();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }

    }
    //End of Fetching Section

    private DateTime dateTimeValue = DateTime.Now;
    private void UpdateDateOnly()
    {
        newEntry.datetime = DateOnly.FromDateTime(dateTimeValue);
    }



}
