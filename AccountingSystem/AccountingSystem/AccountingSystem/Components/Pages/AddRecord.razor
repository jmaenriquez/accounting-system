@page "/addrecords"
@using Microsoft.EntityFrameworkCore;
@using AccountingSystem.Data
@using AccountingSystem.Services
@inject NavigationManager Navigate
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject Data.AppDbContext DbContext
@inject GroupService grpService
@inject AccountService accountService;


<MudDialog>
    <DialogContent>
        <MudForm Model="@newEntry" Class="mt-5">

            <MudContainer>

                <MudDatePicker Label="Date" @bind-Date="dateTime"
                DateFormat="MM-dd-yyyy" Required="true" Clearable="true" />

                <MudTextField Label="Description"
                @bind-Value="newEntry.description"
                Required="true" MaxLength="50" />

                <MudSelect T="Account_List" Label="Account Name" @bind-Value="newEntry.AccName">
                    @foreach (var accs in AccountNames)
                    {
                        <MudSelectItem T="Account_List" Value="@accs">@accs.name</MudSelectItem>
                    }
                </MudSelect>

                <MudSelect T="Group_List" Label="Account Group" @bind-Value="newEntry.AccGrp">
                    @foreach (var gnames in GroupList)
                    {
                        <MudSelectItem T="Group_List" Value="@gnames">@gnames.name</MudSelectItem>
                    }
                </MudSelect>

                <MudTextField Label="Amount" Type="number"
                @bind-Value="tempAcc"
                Required="true" />

            </MudContainer>

            <MudContainer>
                @if(journalRecord == null)
                {
                    <MudButton Class="mt-4" OnClick="Save" Style="background-color: #F9F9F9;">Save</MudButton>
                }
                else
                {
                    <MudButton Class="mt-4" OnClick="Save" Style="background-color: #F9F9F9;">Confirm</MudButton>
                }
            </MudContainer>
        </MudForm>

        <MudTable T="Journal_Entry" Items="@Entries" Class="mt-3" Dense="true" Hover="true"
        OnRowClick="SelectEntry">
            <HeaderContent>
                <MudTh></MudTh>
                <MudTh>Account</MudTh>
                <MudTh>Group</MudTh>
                <MudTh>Debit</MudTh>
                <MudTh>Credit</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd><MudIconButton Icon="@Icons.Material.Filled.Delete" OnClick="() => RemoveTrial(context)" /></MudTd>
                <MudTd>@context.AccName?.name</MudTd>
                <MudTd>@context.AccGrp?.name</MudTd>
                <MudTd>@(context.debit > 0 ? $"{context.debit:N0}" : "")</MudTd>
                <MudTd>@(context.credit > 0 ? $"{context.credit:N0}" : "")</MudTd>
            </RowTemplate>
            <FooterContent>
                <MudTd></MudTd>
                <MudTd></MudTd>
                <MudTd>Total</MudTd>
                <MudTd>@Overall.ToString("N2")</MudTd>
            </FooterContent>
        </MudTable>
    </DialogContent>

    <DialogActions>
        @if(journalRecord == null)
        {
            <MudButton Onclick="Submit" Style="background-color: #00828F; color:#ffffff;">Add</MudButton>
            <MudButton Class="ml-2" OnClick="goBack" Color="Color.Error" Variant="Variant.Outlined">Cancel</MudButton>
        }
        else
        {
            <MudButton Onclick="Submit" Style="background-color: #00828F; color:#ffffff;">Save</MudButton>
            <MudButton Class="ml-2" OnClick="goBack" Color="Color.Error" Variant="Variant.Outlined">Cancel</MudButton>
        }

    </DialogActions>
</MudDialog>


@code {

    List<Group_List> GroupList = new List<Group_List>();
    List<Account_List> AccountNames = new List<Account_List>();

    [Parameter]
    public Journal_Entry journalRecord { get; set; }

    public List<Journal_Entry> FilteredEntries => Entries
        .Where(a => a.TransactId == journalRecord?.TransactId)
        .ToList();


    private decimal TotalDebit => Entries.Where(a => a.AccGrp?.type == AccountType.Debit).Sum(a => a.debit ?? 0);
    private decimal TotalCredit => Entries.Where(a => a.AccGrp?.type == AccountType.Credit).Sum(a => a.credit ?? 0);

    public decimal Overall => TotalDebit - TotalCredit;
    private decimal? tempAcc;
    DateTime? dateTime;



    private void goBack()
    {
        Navigate.NavigateTo("/journal");
    }



    private void RemoveTrial(Journal_Entry trial)
    {
        Entries.Remove(trial);
        StateHasChanged();
    }

    List<Journal_Entry> Entries = new List<Journal_Entry>();
    public Journal_Entry newEntry = new Journal_Entry();


    private async Task Save()
    {
        newEntry.datetime = dateTime ?? newEntry.datetime;
        newEntry.debit = newEntry.Type == AccountType.Debit ? tempAcc ?? 0 : 0;
        newEntry.credit = newEntry.Type == AccountType.Credit ? tempAcc ?? 0 : 0;

        if (journalRecord != null)
        {
            var existingEntry = Entries.FirstOrDefault(e => e.id == newEntry.id);
            if (existingEntry != null)
            {
                existingEntry.datetime = newEntry.datetime;
                existingEntry.description = newEntry.description;
                existingEntry.AccName = newEntry.AccName;
                existingEntry.AccGrp = newEntry.AccGrp;
                existingEntry.debit = newEntry.debit;
                existingEntry.credit = newEntry.credit;
            };

            newEntry = new Journal_Entry();
            tempAcc = null;
            StateHasChanged();

            await Task.CompletedTask;
        }
        else
        {
            if (newEntry.AccGrp == null || newEntry.AccName == null || newEntry.description == null)
            {
                Snackbar.Add("Please Fill the Empty Fields", Severity.Warning);
                return;
            }
            else
            {
                Entries.Add(new Journal_Entry
                    {
                        datetime = newEntry.datetime,
                        description = newEntry.description,
                        AccName = newEntry.AccName,
                        AccGrp = newEntry.AccGrp,
                        debit = newEntry.debit,
                        credit = newEntry.credit,
                    });


                newEntry = new Journal_Entry();
                tempAcc = null;
                StateHasChanged();

                await Task.CompletedTask;
            }
        }



    }


    private async Task Submit()
    {
        newEntry.datetime = newEntry.datetime.Date;
        var TransactId = Guid.NewGuid();

        if(journalRecord == null)
        {
            if (Overall == 0)
            {

                foreach (var entry in Entries)
                {
                    var journal = new Journal_Entry
                        {
                            TransactId = TransactId,
                            datetime = entry.datetime,
                            description = entry.description,
                            AccGrpId = entry.AccGrp!.id,
                            AccNameId = entry.AccName!.id,
                            debit = entry.debit,
                            credit = entry.credit,

                        };

                    DbContext.Journal.Add(journal);
                }

                await DbContext.SaveChangesAsync();
                Snackbar.Add("New Entry Added", Severity.Success);


                Entries.Clear();
                tempAcc = null;

            }
            else
            {
                Snackbar.Add("Record Must Be Balanced!", Severity.Error);
                return;
            }
        }

        else
        {
            if (Overall == 0)
            {
                var existingEntries = await DbContext.Journal
                    .Where(j => j.TransactId == journalRecord.TransactId)
                    .ToListAsync();

                if (Entries != null)
                {
                    foreach (var entry in existingEntries)
                    {
                        entry.datetime = newEntry.datetime;
                        entry.description = newEntry.description;
                        entry.AccGrpId = newEntry.AccGrp?.id ?? 0;
                        entry.AccNameId = newEntry.AccName?.id ?? 0;
                        entry.debit = newEntry.debit;
                        entry.credit = newEntry.credit;
                    }

                    await DbContext.SaveChangesAsync();
                    StateHasChanged();
                    Snackbar.Add("Edit successfully!", Severity.Success);
                }
                Navigate.NavigateTo("/journal");
            }
        }

    }

    protected override async Task OnInitializedAsync()
    {
        if (journalRecord != null)
        {
            newEntry = new Journal_Entry
                {
                    datetime = journalRecord.datetime,
                    id = journalRecord.id,
                    TransactId = journalRecord.TransactId,
                    description = journalRecord.description,
                    AccNameId = journalRecord.AccName!.id,
                    AccGrpId = journalRecord.AccGrp!.id,
                    debit = journalRecord.debit,
                    credit = journalRecord.credit
                };

            Entries = await DbContext.Journal
                .Where(j => j.TransactId == journalRecord.TransactId)
                .Include(j => j.AccGrp)
                .Include(j => j.AccName)
                .ToListAsync();
        }
        else
        {
            Entries = new List<Journal_Entry>();
        }

        try
        {
            var filterName = await grpService.GroupItems();
            GroupList = filterName.ToList();

            var filterAcc = await accountService.GetAllAccounts();
            AccountNames = filterAcc.ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    private void SelectEntry(TableRowClickEventArgs<Journal_Entry> e)
    {
        var selectedEntry = e.Item;

        if (selectedEntry != null)
        {
            var accName = selectedEntry.AccName!.name;
            var accGrp = selectedEntry.AccGrp!.name;
            newEntry = new Journal_Entry
                {
                    datetime = selectedEntry.datetime,
                    id = selectedEntry.id,
                    TransactId = selectedEntry.TransactId,
                    description = selectedEntry.description,
                    AccName = selectedEntry.AccName,
                    AccGrp = selectedEntry.AccGrp,
                    debit = selectedEntry.debit,
                    credit = selectedEntry.credit
                };

            dateTime = newEntry.datetime;
            tempAcc = newEntry.debit > 0 ? newEntry.debit : newEntry.credit;

            StateHasChanged();
        }
    }


}
