@page "/journal"  
@using AccountingSystem.Data  
@using AccountingSystem.Services  
@inject JournalService jservice  
@inject NavigationManager Navigate    
@inject ISnackbar Snackbar  
@inject IDialogService DialogService

<PageTitle>Journal Entries</PageTitle>  

<div class = "rounded-3">  

    <div class="top-container">  
 
        <h4 class="m-3 w-100">Journal Entries</h4>

        <div class="buttons" style="display: flex; align-items: center;">
            <MudHidden Breakpoint="Breakpoint.SmAndDown">
                <input class="searchbar" type="text" placeholder="Search..." @oninput="FilterEntries" />
            </MudHidden>
            <MudHidden Breakpoint="Breakpoint.MdAndUp">
                <div class="mobile-search">
                    <MudButton Variant="Variant.Filled" OnClick="ToggleSearch" Style="width:fit-content; background-color:#00828F; color:white; margin-left: 10px;">
                        <MudIcon Class="search-icon" Icon="@Icons.Material.Filled.Search" />
                    </MudButton>
                    <input class="search-input @(isSearchOpen ? "expanded" : "")" type="text" placeholder="  Search..." @oninput="FilterEntries" autofocus />
                </div>
            </MudHidden>

            <MudButton Variant="Variant.Filled" OnClick="OpenAddRecDialog" Style="width:fit-content; background-color:#00828F; color:white; margin-left: 10px;">
                <MudHidden Breakpoint="Breakpoint.SmAndDown">
                    <MudIcon Icon="@Icons.Material.Filled.Add" /> New Entry
                </MudHidden>
                <MudHidden Breakpoint="Breakpoint.MdAndUp">
                    <MudIcon Icon="@Icons.Material.Filled.Add" />
                </MudHidden>
            </MudButton>
        </div>
    </div>

    <div id="Tables" class="mt-3">
        <div class="table-responsive container-fluid">
            <table class="table shadow-sm rounded-2" style="background-color: white;">
                <thead class="custom-table-header">
                    <MudTh Class="fw-bold">Date</MudTh>
                    <MudTh Class="fw-bold">Journal Code</MudTh>
                    <MudTh Class="fw-bold">Description</MudTh>
                    <MudTh Class="fw-bold">Account Name</MudTh>
                    <MudTh Class="fw-bold">Debit</MudTh>
                    <MudTh Class="fw-bold">Credit</MudTh>
                    <MudTh Class="fw-bold">Comments</MudTh>
                    <MudTh Class="fw-bold"></MudTh>
                </thead>
                <tbody>
                    @foreach (var group in FilteredEntries.GroupBy(j => j.TransactId))
                    {
                        bool firstRow = true;

                        foreach (var jlist in group)
                        {
                            <tr>
                                @if (firstRow)
                                {
                                    <td rowspan="@group.Count()">
                                        @group.First().datetime.ToString("MM-dd-yyyy")
                                    </td>

                                    <td rowspan="@group.Count()">
                                        @group.Key
                                    </td>
                                }
                                <td>@jlist.description</td>
                                <td>@jlist.AccName?.name</td>
                                <td>@((jlist.debit > 0) ? $"{jlist.debit:N2}" : "")</td>
                                <td>@((jlist.credit > 0) ? $"{jlist.credit:N2}" : "")</td>


                                @if(firstRow)
                                {
                                    <td rowspan="@group.Count()">@jlist.enterRemark</td>
                                    <td rowspan="@group.Count()">
                                        <MudMenu Icon="@Icons.Material.Filled.MoreVert">
                                            <MudMenuItem Icon="@Icons.Material.Filled.Edit" Label="Edit" OnClick="() => Edit(group.Key)"></MudMenuItem>
                                            <MudMenuItem Icon="@Icons.Material.Filled.Delete" Label="Delete"
                                            OnClick="() => Delete(group.Key)" />
                                        </MudMenu>
                                    </td>

                                    firstRow = false;
                                }
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>  



@code {

    private bool isSearchOpen = false;

    private void ToggleSearch()
    {
        isSearchOpen = !isSearchOpen;
    }

    List<Journal_Entry> Entries = new List<Journal_Entry>();  
    List<Journal_Entry> FilteredEntries = new List<Journal_Entry>();  

    protected override async Task OnInitializedAsync()  
    {  
        Entries = (await jservice.journalentries())  
        .Where(x => !x.isDeleted)  
        .ToList();
        FilteredEntries = Entries;

        Console.WriteLine($"Entries Count{Entries.Count}");
    }  

    private void FilterEntries(ChangeEventArgs e)  
    {  
        var searchTerm = e.Value?.ToString();  
        if (string.IsNullOrEmpty(searchTerm))  
        {  
            FilteredEntries = Entries;  
        }  
        else  
        {  
            FilteredEntries = Entries.Where(entry => entry.AccName!.name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) || entry.description.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) || entry.datetime.ToString("MM-dd-yyyy").Contains(searchTerm, StringComparison.OrdinalIgnoreCase) || entry.debit.ToString()!.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) || entry.credit.ToString()!.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)
            ).ToList();
        }  
    }

    private async Task Delete(Guid transactId)
    {
        var entriesToRemove = Entries.Where(e => e.TransactId == transactId).ToList();
        foreach (var entry in entriesToRemove)
        {
            entry.isDeleted = true;
        }

        await jservice.UpdateJournalEntries(entriesToRemove);
        Entries = Entries.Where(e => !e.isDeleted).ToList();
        FilteredEntries = Entries;
        StateHasChanged();

        Snackbar.Add("An Entry has been marked as Deleted", Severity.Success);
    }

    private async Task Edit(Guid transactId)
    {
        
        var entryToEdit = Entries.Where(e => e.TransactId == transactId).ToList();
        var parameters = new DialogParameters
    {
        { "journalRecord", entryToEdit }
    };

        var options = new DialogOptions { 
            CloseButton = true, 
            MaxWidth = MaxWidth.Medium, 
            FullWidth = true,
            Position = DialogPosition.Center,
            BackdropClick = true
        };
        var dialog = await DialogService.ShowAsync<AddRecord>("Edit Records", parameters, options);
        var result = await dialog.Result;
        
    }

    private async Task OpenAddRecDialog()
    {
        var parameters = new DialogParameters();
        var options = new DialogOptions { 
            CloseButton = true, 
            MaxWidth = MaxWidth.Medium, 
            FullWidth = true,
            Position = DialogPosition.Center,
            BackdropClick = true
        };
        var dialog = await DialogService.ShowAsync<AddRecord>("Add New Record", parameters, options);
        var result = await dialog.Result;

    }
}