@page "/journal"  
@using AccountingSystem.Data  
@using AccountingSystem.Services  
@inject JournalService jservice  
@inject NavigationManager Navigate  
@inject IModalService Modal  
@inject ISnackbar Snackbar  

<PageTitle>Journal Entries</PageTitle>  

<div class = "rounded-3">  

    <div class="top-container">  

        @* <h3 class="m-4">Journal Entries</h3> *@  
        <h4 class="m-3 w-25">Journal Entries</h4>  

        <div class="buttons">  
            <input class = "searchbar" type="text" placeholder="Search..." @oninput="FilterEntries" />  
            <button class="btn add" @onclick="goToAddRec">Add New Record</button>  

        </div>  
    </div>  

    <div id="Tables" class="mt-2">
        <table class="mt-3 table table-borderless table-sm">
            <thead class="table-info ">
                <tr>
                    <th>Date</th>
                    <th>Journal Code</th>
                    <th>Description</th>
                    <th>Account Name</th>
                    <th>Debit</th>
                    <th>Credit</th>
                    <th>Comments</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var group in FilteredEntries.GroupBy(j => j.TransactId))
                {
                    bool firstRow = true;
                    foreach (var jlist in group)
                    {
                        <tr class="border-bottom">
                            @if (firstRow)
                            {
                                <td rowspan="@group.Count()">@jlist.datetime.ToString("MM-dd-yyyy")</td>
                                <td rowspan="@group.Count()">@group.Key</td>
                            }
                            <td>@(jlist.description)</td>
                            <td>@(jlist.debit > 0 ? jlist.AccName!.name : " " + jlist.AccName!.name)</td>
                            <td>@(jlist.debit > 0 ? $"{jlist.debit:N0}" : "")</td>
                            <td>@(jlist.credit > 0 ? $"{jlist.credit:N0}" : "")</td>

                            @if (firstRow)
                            {
                                <td rowspan="@group.Count()" class="align-middle">@jlist.enterRemark</td>
                                <td rowspan="@group.Count()" class="align-middle">
                                    <MudMenu Icon="@Icons.Material.Filled.MoreVert">
                                        <MudMenuItem Icon="@Icons.Material.Filled.Edit" Label="Edit" />
                                        <MudMenuItem Icon="@Icons.Material.Filled.Delete" Label="Delete" OnClick="() => Delete(group.Key)" />
                                    </MudMenu>
                                </td>

                                firstRow = false;
                            }

                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>  

@code {

 private void goToAddRec()  
 {  
     Navigate.NavigateTo("/addrecords");  
 }  

 private void ShowModal()  
 {  
     Modal.Show<AddRecord>("/addrecords");  
 }  

 private async Task Delete(Guid transactId)  
 {  
     var entriesToRemove = Entries.Where(e => e.TransactId == transactId).ToList();  
     foreach (var entry in entriesToRemove)  
     {  
         entry.isDeleted = true; // Set the IsDeleted flag  
     }  

     await jservice.UpdateJournalEntries(entriesToRemove); // Ensure the changes are saved to the database  
     Entries = Entries.Where(e => !e.isDeleted).ToList(); // Update the Entries list  
     FilteredEntries = Entries; // Update the FilteredEntries list  
     StateHasChanged();  

     Snackbar.Add("An Entry has been marked as Deleted", Severity.Success);  
 }  

 List<Journal_Entry> Entries = new List<Journal_Entry>();  
 List<Journal_Entry> FilteredEntries = new List<Journal_Entry>();  

 protected override async Task OnInitializedAsync()  
 {  
     Entries = (await jservice.journalentries())  
     .Where(x => !x.isDeleted)  
     .ToList();  
     FilteredEntries = Entries;  
 }  

 private void FilterEntries(ChangeEventArgs e)  
 {  
     var searchTerm = e.Value?.ToString();  
     if (string.IsNullOrEmpty(searchTerm))  
     {  
         FilteredEntries = Entries;  
     }  
     else  
     {  
          FilteredEntries = Entries.Where(entry => entry.AccName!.name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) || entry.description.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)).ToList();
     }  
 }  
}