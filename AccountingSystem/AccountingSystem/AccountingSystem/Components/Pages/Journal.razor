@page "/journal"
@using AccountingSystem.Data
@using AccountingSystem.Services
@inject JournalService jservice
@inject NavigationManager Navigate
@inject IModalService Modal

<PageTitle>Journal Entries</PageTitle>

<div class = "rounded-3">

    <div class="top-container">

        @* <h3 class="m-4">Journal Entries</h3> *@
        <h4 class="m-4">Journal Entries</h4>

        <div class="buttons">
            <input class = "searchbar" type="text" placeholder="Search..." />
            @* <button class="btn add" @onclick="ShowModal">Add New Record</button> *@
            <button class="btn add" @onclick="goToAddRec">Add New Record</button>

        </div>
    </div>

    <div id="Tables" class="mt-2">
        <table class="mt-3 table table-borderless table-sm">
            <thead class="table-info ">
                <tr>
                    <th>Date</th>
                    <th>Journal Code</th>
                    <th>Description</th>
                    <th>Account Name</th>
                    <th>Debit</th>
                    <th>Credit</th>
                    <th>Comments</th>
                    <th> </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var group in Entries.GroupBy(j => j.TransactId))
                {
                    bool firstRow = true;
                    foreach (var jlist in group)
                    {
                        <tr class="border-bottom">
                            @if (firstRow)
                            {
                                <td rowspan="@group.Count()">@jlist.datetime.ToString("MM-dd-yyyy")</td>
                                <td rowspan="@group.Count()">@group.Key</td>

                                firstRow = false;
                            }
                            <td>@(jlist.description)</td>
                            <td>@(jlist.debit > 0 ? jlist.AccName!.name : " " + jlist.AccName!.name)</td>
                            <td>@(jlist.debit > 0 ? $"{jlist.debit:N0}" : "")</td>
                            <td>@(jlist.credit > 0 ? $"{jlist.credit:N0}" : "")</td>
                            <td><i>@jlist.enterRemark</i></td>
                            <td>Actions</td>
                        </tr>
                    }
                }



            </tbody>
        </table>
    </div>
    
</div>

@code {
	private void goToAddRec()
	{
		Navigate.NavigateTo("/addrecords");
	}

    private void ShowModal()
    {
        Modal.Show<AddRecord>("/addrecords");
    }

    List<Journal_Entry> Entries = new List<Journal_Entry>();

    protected override async Task OnInitializedAsync()
    {
        Entries = (await jservice.journalentries()).ToList();
    }
}