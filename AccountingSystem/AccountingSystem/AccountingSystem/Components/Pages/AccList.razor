@page "/acclist"
@inject NavigationManager Navigate



<PageTitle>Account List</PageTitle>

<div class="rounded-3">

    <div class="top-container">

        <h3 class="m-4">Account List</h3>

        <div class="buttons">
            <input class="searchbar" type="text" placeholder="Search..." />
            <button class="btn add" @onclick="navigateToAddAcc">Add Account</button>
        </div>
    </div>

    <table class="mt-3 table table-borderless table-sm">
        <thead class="table-info ">
            <tr>
                <th>Date</th>
                <th>Account Id</th>
                <th>Account Name</th>
                <th>Description</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>

            @foreach (var acc in AccountList)
            {
                <tr>
                    <td>@acc.date</td>
                    <td>@acc.id</td>
                    <td>@acc.name</td>
                    <td>@acc.description</td>
                    <td>@acc.status</td>
                    <td>Actions</td>
                </tr>
            }
        </tbody>
    </table>
</div>


@using AccountingSystem.Data
@using AccountingSystem.Services
@inject AccountService accountService;

@code {

    public void navigateToAddAcc()
    {
        Navigate.NavigateTo("/addacc");
    }

    List<Account_List> AccountList = new List<Account_List>();

    protected override async Task OnInitializedAsync()
    {
        await LoadAccounts();
        await Refresh();

    }

    private async Task LoadAccounts()
    {
        AccountList = (await accountService.GetAllAccounts()).ToList();
        StateHasChanged();
    }

    private async Task Refresh()
    {
        while (true)
        {
            await Task.Delay(500);
            await LoadAccounts();
        }
    }
}