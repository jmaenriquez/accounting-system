@page "/acclist"  
@using AccountingSystem.Data  
@using AccountingSystem.Services  
@inject AccountService accountService;  
@inject IModalService Modal  
@inject ISnackbar Snackbar  
@inject IDialogService DialogService
@inject NavigationManager Navigate  


<PageTitle>Account List</PageTitle>

<div class="rounded-3">

    <div class="top-container">

        <h4 class="m-4 w-25">Account List</h4>

        <div class="buttons" style="display: flex; align-items: center;">
            <MudHidden Breakpoint="Breakpoint.SmAndDown">
                <input class="searchbar" type="text" placeholder="Search..." @oninput="FilterEntries" />
            </MudHidden>
            <MudHidden Breakpoint="Breakpoint.MdAndUp">
                <div class="mobile-search">
                    <MudButton Variant="Variant.Filled" OnClick="ToggleSearch" Style="width:fit-content; background-color:#00828F; color:white; margin-left: 10px;">
                        <MudIcon Class="search-icon" Icon="@Icons.Material.Filled.Search" />
                    </MudButton>
                    <input class="search-input @(isSearchOpen ? "expanded" : "")" type="text" placeholder="Search..." @oninput="FilterEntries" autofocus />
                </div>
            </MudHidden>

            <MudButton Variant="Variant.Filled" OnClick="OpenAddAccDialog" Style="width:fit-content; background-color:#00828F; color:white; margin-left: 10px;">
                <MudHidden Breakpoint="Breakpoint.SmAndDown">
                    <MudIcon Icon="@Icons.Material.Filled.Add" /> New Entry
                </MudHidden>
                <MudHidden Breakpoint="Breakpoint.MdAndUp">
                    <MudIcon Icon="@Icons.Material.Filled.Add" />
                </MudHidden>
            </MudButton>
        </div>
    </div>

    <div>
        <div class="container-fluid">
            <MudTable Class="mt-4" Items="@FilteredEntries" Dense="true"
            Breakpoint="Breakpoint.Sm">
                <HeaderContent>
                    <MudTh Class="fw-bold">Account Id</MudTh>
                    <MudTh Class="fw-bold">Account Name</MudTh>
                    <MudTh Class="fw-bold">Description</MudTh>
                    <MudTh Class="fw-bold">Status</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd data-label="Account Id">@context.id</MudTd>
                    <MudTd data-label="Account Name">@context.name</MudTd>
                    <MudTd data-label="Description">@context.description</MudTd>
                    <MudTd data-label="Status">@context.status</MudTd>
                    <MudTd>
                        <MudMenu Icon="@Icons.Material.Filled.MoreVert">
                            <MudMenuItem Icon="@Icons.Material.Filled.Edit" Label="Edit" OnClick="() => Edit(context)" />
                            <MudMenuItem Icon="@Icons.Material.Filled.Delete" Label="Delete" OnClick="() => isDeleted(context.id)" />
                        </MudMenu>
                    </MudTd>
                </RowTemplate>

            </MudTable>
        </div>
    </div>
</div>




@code {
    private bool isSearchOpen = false;

    private void ToggleSearch()
    {
        isSearchOpen = !isSearchOpen;
    }


    List<Account_List> AccountList = new List<Account_List>();
    List<Account_List> FilteredEntries = new List<Account_List>();

    public Account_List updateAcc = new Account_List
   {
           date = DateOnly.FromDateTime(DateTime.Now),
           name = "",
           description = "",
   };

    protected override async Task OnInitializedAsync()
    {
        AccountList = (await accountService.GetAllAccounts())
        .Where(a => !a.isDeleted)
        .ToList();
        FilteredEntries = AccountList;

    }

    private async Task isDeleted(int accountId)
    {
        var account = AccountList.FirstOrDefault(e => e.id == accountId);
        if (account != null)
        {
            account.isDeleted = true;
        }
        await accountService.UpdateAccount(new List<Account_List> { account! });
        AccountList = AccountList.Where(e => !e.isDeleted).ToList();
        StateHasChanged();
        FilteredEntries = AccountList;

        Snackbar.Add("An Account has been marked as Deleted", Severity.Success);
    }

    private async Task Edit(Account_List accs)
    {
        var parameters = new DialogParameters
    {
        { "accs", accs }
    };
        var options = new DialogOptions
            {
                CloseButton = true,
                MaxWidth = MaxWidth.Small,
                FullWidth = true,
                Position = DialogPosition.Center,
                BackdropClick = true
            };
        var dialog = await DialogService.ShowAsync<AddAcc>("Edit Account", parameters, options);
        var result = await dialog.Result;
    }

   private async Task OpenAddAccDialog()
   {
       var parameters = new DialogParameters();
       var options = new DialogOptions { 
           CloseButton = true, 
           MaxWidth = MaxWidth.Small, 
           FullWidth = true,
           Position = DialogPosition.Center,
           BackdropClick = true
       };
       var dialog = await DialogService.ShowAsync<AddAcc>("Add New Account", parameters, options);
       var result = await dialog.Result;

   }

    private void FilterEntries(ChangeEventArgs e)
    {
        var searchTerm = e.Value?.ToString();
        if (string.IsNullOrEmpty(searchTerm))
        {
            FilteredEntries = AccountList;
        }
        else
        {
            FilteredEntries = AccountList.Where(entry => entry.name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) || entry.description.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) || entry.date.ToString("MM-dd-yyyy").Contains(searchTerm, StringComparison.OrdinalIgnoreCase) 
            ).ToList();
        }
    }
}