    public void navigateToAddAcc()
    {
        Navigate.NavigateTo("/addacc");
    }

    List<Account_List> AccountList = new List<Account_List>();

    protected override async Task OnInitializedAsync()
    {
        await LoadAccounts();
        await Refresh();

    }

    private async Task LoadAccounts()
    {
        AccountList = (await accountService.GetAllAccounts()).ToList();
        StateHasChanged();
    }

    private async Task Refresh()
    {
        while (true)
        {
            await Task.Delay(500);
            await LoadAccounts();
        }
    }
