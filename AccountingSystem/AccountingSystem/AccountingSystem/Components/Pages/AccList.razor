@page "/acclist"
@using AccountingSystem.Data
@using AccountingSystem.Services
@inject AccountService accountService;
@inject IModalService Modal  
@inject ISnackbar Snackbar  
@inject NavigationManager Navigate

<PageTitle>Account List</PageTitle>

<div class="rounded-3">

    <div class="top-container">

        <h4 class="m-4 w-25">Account List</h4>

        <div class="buttons">
            <input class="searchbar" type="text" placeholder="Search..." />
            <button class="btn add" @onclick="navigateToAddAcc">Add New Account</button>
        </div>
    </div>

    <div>
        <div class="container-fluid">
            <MudTable Class="mt-4" Items="@AccountList" Dense="true"
                      Breakpoint="Breakpoint.Sm">
                <HeaderContent>
                    <MudTh Class="fw-bold">Account Id</MudTh>
                    <MudTh Class="fw-bold">Account Name</MudTh>
                    <MudTh Class="fw-bold">Description</MudTh>
                    <MudTh Class="fw-bold">Status</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.id</MudTd>
                    <MudTd>@context.name</MudTd>
                    <MudTd>@context.description</MudTd>
                    <MudTd>@context.status</MudTd>
                    <MudTd>
                        <MudMenu Icon="@Icons.Material.Filled.MoreVert">
                            <MudMenuItem Icon="@Icons.Material.Filled.Edit" Label="Edit" />
                            <MudMenuItem Icon="@Icons.Material.Filled.Delete" Label="Delete" OnClick="() => isDeleted(context.id)" />
                        </MudMenu>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </div>
    </div>
</div>



@code {

    public void navigateToAddAcc()
    {
        Navigate.NavigateTo("/addacc");
    }

    List<Account_List> AccountList = new List<Account_List>();

    protected override async Task OnInitializedAsync()
    {
        AccountList = (await accountService.GetAllAccounts())
        .Where(a => !a.isDeleted)
        .ToList();
        StateHasChanged();

    }

    private async Task isDeleted(int accountId)
    {
        var account = AccountList.FirstOrDefault(e => e.id == accountId);
        if (account != null)
        {
            account.isDeleted = true;
            await accountService.UpdateAccount(new List<Account_List> { account });
            AccountList = AccountList.Where(e => !e.isDeleted).ToList();
            StateHasChanged();
            Snackbar.Add("An Account has been marked as Deleted", Severity.Success);
        }
    }
}